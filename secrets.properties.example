# Copy this file to secrets.properties and fill in the real URLs. processResources bundles
# whichever file exists into the jar as thm-secrets.properties, which APIUtils reads at runtime -
# these URLs aren't secret (every request requires a valid API token regardless), so no
# obfuscation is applied to them and APIUtils.java itself is never modified by the build.
api.memberHud=https://your-api.example.com/users
api.highway=https://your-api.example.com/
api.status=https://your-api.example.com/
api.highwayStatus=https://your-api.example.com/status
api.cape=https://your-api.example.com/capes
api.capePost=https://your-api.example.com/capes/set
api.capeIndex=https://your-website.example.com/cape/index
