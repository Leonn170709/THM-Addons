{
  "schemaVersion": 1,
  "id": "thm-addon",
  "version": "${version}",
  "name": "THM Addon",
  "description": "The Addon by THM for Meteor Client",
  "authors": [
    "Leonn170709",
    "DaReapsta"
  ],
  "contact": {
    "repo": "https://github.com/Leonn170709/THM-Addons",
    "issues": "https://github.com/Leonn170709/THM-Addons/issues",
    "discord": "https://discord.gg/thm"
  },
  "icon": "assets/icon/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "xyz.thm.addon.THMAddon"
    ],
    "client": [
      "xyz.thm.addon.THMAddon"
    ]
  },
  "mixins": [
    "thm-addon.mixins.json",
    "thm-addon.sodium.mixins.json",
    "thm-addon.xaero.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "0,255,255",
    "github:sha": "${gh_hash}",
    "github:branch": "${gh_branch}",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      },
      "links": {
        "modmenu.discord": "https://discord.gg/thm"
      }
    }
  },
  "depends": {
    "java": ">=25",
    "minecraft": "26.2",
    "meteor-client": ">=26.2- <26.3-",
    "fabric-api": "*"
  },
  "suggests": {
    "baritone": "*",
    "baritone-meteor": "*"
  }
}
